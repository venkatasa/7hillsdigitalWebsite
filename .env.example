APP_NAME="7Hills Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Johannesburg
APP_URL=http://localhost:8091

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sevenhills
DB_USERNAME=sevenhills
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Brand palette — the OFFICIAL 7Hills colours, from
# public/images/brand/Brand_Guidelines_And_Color_Codes.html.
# Do not introduce a colour that is not in that document.
# ---------------------------------------------------------------------------
BRAND_PRIMARY="#1A2E22"
BRAND_ACCENT="#417956"
BRAND_MINT="#5EB87E"
BRAND_INK="#111111"
BRAND_SECONDARY="#5C6861"
BRAND_DARK="#122118"
BRAND_LIGHT="#F8FAF9"
BRAND_MUTED="#64726A"
BRAND_HAIRLINE="#E2E8E5"

# ---------------------------------------------------------------------------
# Company details rendered across the site.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME="7Hills Holdings (Pty) Ltd"
COMPANY_PARENT="7Hills Holdings"
COMPANY_TRADING_AS="7Hills Digital"
COMPANY_EMAIL="hello@7hillsdigital.co.za"
COMPANY_SALES_EMAIL="sales@7hillsdigital.co.za"
COMPANY_PHONE="068 859 6695"
COMPANY_WHATSAPP="068 859 6695"
COMPANY_CITY="Midrand"
COMPANY_PROVINCE="Gauteng"

# ---------------------------------------------------------------------------
# Statutory company details — ECTA s43 and POPIA. BLANK ON PURPOSE: fill these
# in from the CIPC documents. Do not invent a registration number.
# ---------------------------------------------------------------------------
COMPANY_REG_NUMBER=""
COMPANY_VAT_NUMBER=""
COMPANY_DIRECTORS=""
COMPANY_REG_PLACE="Republic of South Africa"
COMPANY_PHYSICAL_ADDRESS=""
COMPANY_SERVICE_ADDRESS=""
COMPANY_INFORMATION_OFFICER=""
COMPANY_INFORMATION_OFFICER_EMAIL=""

# Where new package enquiries are emailed.
SALES_NOTIFY_EMAIL="sales@7hillsdigital.co.za"

# ---------------------------------------------------------------------------
# Mail. Sends through Absolute Hosting / zadns, the same server the domain's
# MX points at, so the SPF and DKIM records published on 7hillsdigital.co.za
# cover it. MAIL_USERNAME and MAIL_FROM_ADDRESS must stay on this domain —
# authenticating as one domain and sending as another is exactly what Gmail
# rejected in August 2026.
#
# Verify with: php artisan mail:check --send=you@example.com
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.7hillsdigital.co.za
MAIL_PORT=465
MAIL_USERNAME="hello@7hillsdigital.co.za"
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="hello@7hillsdigital.co.za"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
