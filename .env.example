APP_NAME="Seven Hills Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Johannesburg
APP_URL=http://localhost:8091

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sevenhills
DB_USERNAME=sevenhills
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Brand palette — see config/brand.php. Placeholder until the real Seven Hills
# Digital artwork lands in brand-assets/.
# ---------------------------------------------------------------------------
BRAND_PRIMARY="#0E2436"
BRAND_ACCENT="#12B3A0"
BRAND_SECONDARY="#4A5A6A"
BRAND_DARK="#081724"
BRAND_LIGHT="#F4F7F9"
BRAND_MUTED="#8494A1"

# ---------------------------------------------------------------------------
# Company details rendered across the site.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME="Seven Hills Digital (Pty) Ltd"
COMPANY_PARENT="Seven Hills Holdings"
COMPANY_EMAIL="hello@7hillsdigital.co.za"
COMPANY_SALES_EMAIL="sales@7hillsdigital.co.za"
COMPANY_PHONE="+27 00 000 0000"
COMPANY_WHATSAPP="+27 00 000 0000"
COMPANY_CITY="Midrand"
COMPANY_PROVINCE="Gauteng"

# Where new package enquiries are emailed.
SALES_NOTIFY_EMAIL="sales@7hillsdigital.co.za"

# ---------------------------------------------------------------------------
# Mail. Must authenticate as the address in MAIL_FROM_ADDRESS — the domain's
# SPF record is strict, so sending as anything else gets filed as spam.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@7hillsdigital.co.za"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
